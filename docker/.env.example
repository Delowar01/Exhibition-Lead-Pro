# =============================================================================
# Card Scanner Pro — self-hosting environment
# =============================================================================
# Copy this file to `.env` (in this docker/ directory) and edit the values:
#
#   cp .env.example .env
#
# Compose reads this file automatically for both variable interpolation in
# docker-compose.yml and as the env_file injected into the api/migrate
# containers. NEVER commit your real .env — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose profiles
# -----------------------------------------------------------------------------
# `local-db` runs the bundled PostgreSQL container. Leave it on to get a fully
# self-contained stack from a single `docker compose up`. To use an EXTERNAL
# managed database instead, set this to empty (COMPOSE_PROFILES=) and update
# DATABASE_URL below to point at your server.
COMPOSE_PROFILES=local-db

# -----------------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------------
# Signing key for JWT auth tokens. Generate a strong random value, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string used by the API and the migrate job.
#   - With the bundled database (COMPOSE_PROFILES=local-db) keep the default;
#     the host `postgres` resolves to the bundled service on the compose network
#     and the credentials must match POSTGRES_* below.
#   - For an external managed database, replace this with your provider's URL,
#     e.g. postgresql://user:pass@db.example.com:5432/cardscanner?sslmode=require
DATABASE_URL=postgresql://cardscanner:cardscanner@postgres:5432/cardscanner

# -----------------------------------------------------------------------------
# Bundled PostgreSQL (only used when COMPOSE_PROFILES=local-db)
# -----------------------------------------------------------------------------
POSTGRES_USER=cardscanner
POSTGRES_PASSWORD=cardscanner
POSTGRES_DB=cardscanner
# Host port to expose Postgres on (container port is always 5432).
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Published ports (host side)
# -----------------------------------------------------------------------------
# The web app (nginx) — open this in your browser.
WEB_PORT=8080
# The API server, exposed directly for debugging or mobile clients.
API_PORT=5000

# -----------------------------------------------------------------------------
# Web → API routing
# -----------------------------------------------------------------------------
# Base href for the built web assets. Use "/" to serve at the domain root, or a
# sub-path like "/app/" if hosting behind a path prefix. Changing this requires
# a rebuild of the web image (it is a build arg).
WEB_BASE_PATH=/
# Where nginx forwards /api requests. The default targets the api container.
API_UPSTREAM=http://api:8080

# -----------------------------------------------------------------------------
# API logging
# -----------------------------------------------------------------------------
# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Optional integrations (leave blank to disable)
# -----------------------------------------------------------------------------
# Google Gemini API key — enables AI OCR, lead scoring, and contact enrichment.
# Without it, scan/AI features that call Gemini will fail; the rest of the app
# works normally.
GEMINI_API_KEY=

# Object storage (Google Cloud Storage) for storing scanned card images. All
# three are optional; if unset, image storage is reported as "not_configured"
# by the readiness check and image persistence is disabled.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# -----------------------------------------------------------------------------
# Optional Redis (disabled unless you enable the `redis` profile)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
