# =============================================================================
# Card Scanner Pro — Hostinger VPS environment (dev.kaptnow.com)
# =============================================================================
# TEMPLATE ONLY — every value below is a placeholder.
#
# The real file lives ONLY on the VPS at:
#
#     /opt/lead-capture-pro/env/.env        (chown leadpro, chmod 600)
#
# with a symlink so the existing compose stack picks it up unchanged
# (docker-compose.yml reads `docker/.env` for interpolation AND injects it as
# the api/migrate env_file):
#
#     ln -s /opt/lead-capture-pro/env/.env  /opt/lead-capture-pro/app/docker/.env
#
# Never commit the real file. Never copy it into GitHub Actions secrets.
# `.env` is gitignored at every depth.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose profiles — MUST stay empty on the VPS
# -----------------------------------------------------------------------------
# Empty = no bundled PostgreSQL container and no Redis container. The database
# is an external Neon PostgreSQL (DATABASE_URL below). Do not enable `local-db`
# or `redis` on this host; the deploy script refuses to run if they resolve.
COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
# Required secrets (API refuses to boot without them)
# -----------------------------------------------------------------------------
# Neon DEVELOPMENT branch connection string (pooled endpoint), e.g.:
#   postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Development database only — never production, never CloudPanel's MySQL.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/leadcapture_dev?sslmode=require

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars

# -----------------------------------------------------------------------------
# Public URL / proxy topology (CloudPanel nginx → web container → api)
# -----------------------------------------------------------------------------
# Base URL used in outgoing email links (password reset, invitations).
APP_BASE_URL=https://dev.kaptnow.com

# Two proxy hops sit in front of the API: CloudPanel's nginx (TLS) and the
# stack's own web/nginx container. Trust exactly those two so req.ip (rate
# limiting, lockouts, IP policies) resolves to the real client address.
TRUST_PROXY=2

# NOTE: no REPLIT_* variable is set anywhere in this deployment. Email links
# use APP_BASE_URL (primary source in config.ts); public card-share links
# (routes/cards.ts publicBaseUrl) derive from the forwarded protocol + Host,
# which the stack's nginx now passes through intact from CloudPanel.

# CORS: leave UNSET. The web app is same-origin behind CloudPanel, and the
# production default is "no cross-origin access", which is correct here.
# CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Web → API routing (defaults are correct; listed for completeness)
# -----------------------------------------------------------------------------
WEB_BASE_PATH=/
API_UPSTREAM=http://api:8080
# NOTE: WEB_PORT / API_PORT from .env.example are intentionally ABSENT —
# compose.vps.yml pins the web binding to 127.0.0.1:18080 and removes the
# api port publication entirely.

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Optional integrations — leave blank until explicitly configured
# -----------------------------------------------------------------------------
# Google Gemini (AI/OCR). Without it the AI features degrade gracefully.
GEMINI_API_KEY=

# Google Cloud Storage — DEVELOPMENT bucket only (docs/HOSTINGER_VPS_DEPLOYMENT.md
# §GCS). Requires the commented volume mount in compose.vps.yml for the
# service-account key. All blank = storage reports "not_configured".
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-service-account.json

# SMTP (transactional email). Unset = honest logged no-op, no real email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=no-reply@kaptnow.com
# EMAIL_FROM_NAME=Lead Capture Pro (dev)
