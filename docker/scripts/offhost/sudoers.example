# =============================================================================
# Lead Capture Pro — backup VPS sudoers drop-in (EXAMPLE, B23 G-6D C1)
# =============================================================================
# /etc/sudoers.d/lcp-offhost   (owner root, mode 0440; validate with visudo -cf)
#
# The upload identity may run exactly one privileged program: the publisher,
# which moves a validated pending file into the vault-owned published tree as
# a brand-new inode. Arguments are validated by the publisher itself (plain
# tokens: object name, size, sha256). The environment is reset (sudo default),
# so the publisher reads its non-secret settings from /etc/lcp-offhost/offhost.env.
# No other command, no shell, no password prompt (NOPASSWD + -n in the receiver).
Defaults:lcp-receive env_reset, !requiretty, use_pty
lcp-receive ALL=(root) NOPASSWD: /opt/lcp-offhost/bin/offhost-publish.sh

# Retention runs from the vault identity's own crontab (no sudo, no SSH):
#   crontab -u lcp-vault -e
#   20 4 * * * OFFHOST_CONFIG=/etc/lcp-offhost/offhost.env bash /opt/lcp-offhost/bin/offhost-retain.sh --apply >> /var/log/lcp-offhost/retain.log 2>&1
# (dry-run first: the same line without --apply; NOT activated by this branch)
