# =============================================================================
# Lead Capture Pro — backup VPS sudoers drop-in (EXAMPLE, B23 G-6D C1/C2/C3)
# =============================================================================
# /etc/sudoers.d/lcp-offhost   (owner root:root, mode 0440; validate with visudo -cf)
#
# The upload identity may run exactly one privileged program: the publisher.
# It is invoked twice per object — first `--preflight <name> <size> <sha256>`
# (READ-ONLY capacity/cap/exists check from the vault the upload identity
# cannot see), then `<name> <size> <sha256>` to publish a validated pending
# file into the vault-owned published tree as a brand-new inode. Arguments are
# validated by the publisher itself (plain tokens only).
#
# Required Defaults (checked by offhost-install-check.sh): env_reset (the
# caller's environment is discarded), !requiretty (the receiver runs without
# a terminal), use_pty. The rule carries NOPASSWD (the receiver uses `sudo -n`)
# and NOSETENV (the caller can never preserve or inject environment variables
# for the publisher). The checker also lists the EFFECTIVE privileges of the
# receive account (`sudo -n -l -U lcp-receive`, read-only) and fails when any
# other sudoers source grants it a further command, a shell, a wildcard, ALL
# or SETENV — this file alone is not the proof.
Defaults:lcp-receive env_reset, !requiretty, use_pty
lcp-receive ALL=(root) NOPASSWD: NOSETENV: /opt/lcp-offhost/bin/offhost-publish.sh

# Retention runs from the vault identity's own crontab (no sudo, no SSH):
#   crontab -u lcp-vault -e
#   20 4 * * * OFFHOST_CONFIG=/etc/lcp-offhost/offhost.env bash /opt/lcp-offhost/bin/offhost-retain.sh --apply >> /var/log/lcp-offhost/retain.log 2>&1
# (dry-run first: the same line without --apply; NOT activated by this branch)
# Retention is a housekeeping control only: the storage boundary is the
# per-slot generation cap, the free-space reserve, the per-archive maximum
# and the dedicated backup file system / quota required at activation.
