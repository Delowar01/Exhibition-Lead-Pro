# =============================================================================
# Lead Capture Pro — backup VPS authorized_keys (EXAMPLE, B23 G-6D C1/C2/C5)
# =============================================================================
# Two local accounts on the BACKUP VPS, THREE key pairs, each with exactly ONE
# forced command. `restrict` disables PTY allocation, agent, X11 and TCP
# forwarding and user rc files; the client's requested command is handed to
# the forced command in SSH_ORIGINAL_COMMAND and parsed as the two-verb
# LCP-OFFHOST/1 protocol — a shell is never reachable.
#
# Key pairs (public keys only ever appear here; no real key is generated by
# the repository; replace the <…> placeholders during activation):
#   1. primary-to-backup UPLOAD key  — private key: primary VPS deploy user
#      ~/.ssh/lcp_offhost_upload_ed25519 (0600)
#   2. primary-to-backup AUDIT key   — private key: primary VPS deploy user
#      ~/.ssh/lcp_offhost_audit_ed25519 (0600)
#   3. GitHub-to-backup AUDIT key    — private key: ONLY the GitHub Actions
#      secret BACKUP_VPS_AUDIT_SSH_KEY; never installed on either VPS
# Keys 2 and 3 are bound to the same read-only audit command but are separate
# key pairs: each can be revoked and attributed on its own (sshd logs the
# fingerprint; the comment field names the holder). offhost-install-check.sh
# enforces this inventory EXACTLY: one receive key, two audit keys, every line
# `restrict,command="…"` with no other option, and three DISTINCT fingerprints
# (a reused or duplicated key fails; comments alone never count as distinct
# keys). Every key must be a COMPLETE OpenSSH public key: the checker parses
# the whole wire structure (type string, exactly 32 key bytes, no missing or
# trailing data) AND runs `ssh-keygen -l -f -` on it; a truncated, padded,
# oversized or type-mismatched blob fails, and a backup VPS without ssh-keygen
# fails closed (authorized-keys-validator-unavailable).
#
# /home/lcp-receive/.ssh/authorized_keys   (owner lcp-receive:lcp-receive, mode 0600; ~/.ssh mode 0700)
restrict,command="/opt/lcp-offhost/bin/offhost-receive.sh" ssh-ed25519 <UPLOAD-PUBLIC-KEY-BASE64> lcp-offhost-upload@primary

# /home/lcp-audit/.ssh/authorized_keys     (owner lcp-audit:lcp-audit, mode 0600; ~/.ssh mode 0700)
restrict,command="/opt/lcp-offhost/bin/offhost-audit.sh" ssh-ed25519 <PRIMARY-AUDIT-PUBLIC-KEY-BASE64> lcp-offhost-audit@primary
restrict,command="/opt/lcp-offhost/bin/offhost-audit.sh" ssh-ed25519 <GITHUB-AUDIT-PUBLIC-KEY-BASE64> lcp-offhost-audit@github-actions

# /home/lcp-vault/.ssh/authorized_keys     MUST NOT EXIST (the vault identity has no SSH login)

# sshd_config on the backup VPS (activation prerequisite). The checker verifies
# the EFFECTIVE configuration of the INSPECTED FILE — `sshd -T -f
# /etc/ssh/sshd_config` globally AND `sshd -T -f /etc/ssh/sshd_config -C
# user=lcp-receive,host=<host>,addr=<addr>` / `user=lcp-audit,…` per restricted
# account — so a `Match User` block that widens one account is caught and the
# daemon's compiled-in default can never stand in for the installed file. The
# inspected path must be canonical (no symlinked component) inside a real
# root-owned, non-writable directory; every Match block may use the User
# criterion only; Includes must stay inside sshd_config.d; the three service
# accounts must have locked passwords. Required effective values (a directive
# that is ABSENT from the dump fails — absence is never read as "none"):
#
#   PermitRootLogin no
#   PasswordAuthentication no
#   KbdInteractiveAuthentication no
#   PubkeyAuthentication yes
#   AuthenticationMethods publickey          # exactly this; "any" fails
#   HostbasedAuthentication no
#   GSSAPIAuthentication no
#   KerberosAuthentication no
#   PermitEmptyPasswords no
#   AuthorizedKeysFile .ssh/authorized_keys  # ONE file; the Ubuntu default
#                                            # adds .ssh/authorized_keys2 → fails
#   AuthorizedKeysCommand none               # no key command (and no command user)
#   TrustedUserCAKeys none                   # no certificate CA
#   AuthorizedPrincipalsFile none            # no principals file or command
#   AuthorizedPrincipalsCommand none
#   ForceCommand none                        # the key-line command stays controlling;
#                                            # no global or Match ForceCommand override
#   StrictModes yes
#   PermitUserEnvironment no                 # no client-controlled environment
#   AcceptEnv LANG LC_*                      # locale only — never OFFHOST_*, LCP_*,
#                                            # PATH, BASH_ENV, ENV, SHELLOPTS,
#                                            # BASHOPTS, LD_* or a broad pattern
#   # no SetEnv for the service accounts
#   AllowUsers lcp-receive lcp-audit <operator-account>
#     literal user names only: no `*`, `?`, `!negation`, `user@host`, comma or
#     bracket/backslash pattern; each service account exactly once; never
#     lcp-vault; every other name must be listed in OFFHOST_SSHD_OPERATOR_USERS
#     (comma-separated) when the checker runs, e.g.
#     OFFHOST_SSHD_OPERATOR_USERS=<operator-account>
#
# Evidence to record in the activation record (output of the real daemon on
# the backup VPS, names and values only — never the file itself):
#   sshd -T -f /etc/ssh/sshd_config | grep -Ei '^(permitrootlogin|passwordauthentication|pubkeyauthentication|kbdinteractiveauthentication|forcecommand|permituserenvironment|allowusers) '
#   sshd -T -f /etc/ssh/sshd_config -C user=lcp-receive,host=$(hostname),addr=127.0.0.1 | grep -Ei '^(authenticationmethods|authorizedkeysfile|authorizedkeyscommand|authorizedkeyscommanduser|trustedusercakeys|authorizedprincipalsfile|authorizedprincipalscommand|authorizedprincipalscommanduser|forcecommand|strictmodes|permituserenvironment|acceptenv|setenv|hostbasedauthentication|gssapiauthentication|kerberosauthentication|permitemptypasswords) '
#   (and the same `-C user=lcp-audit,…` line), followed by
#   OFFHOST_SSHD_OPERATOR_USERS=<operator-account> offhost-install-check.sh → OFFHOST_INSTALL=PASS
