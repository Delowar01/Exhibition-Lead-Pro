# =============================================================================
# Lead Capture Pro — backup VPS non-secret settings (EXAMPLE, B23 G-6D C1/C2)
# =============================================================================
# /etc/lcp-offhost/offhost.env   (owner root:root, mode 0644 — contains NO secret)
# Read by offhost-receive.sh, offhost-publish.sh, offhost-audit.sh and
# offhost-retain.sh (OFFHOST_CONFIG). Only KEY=value lines with plain values.
#
# Layout created at activation (root), on a DEDICATED backup file system or a
# file-system quota that bounds everything under OFFHOST_ROOT:
#   /srv/lcp-offhost/.lcp-offhost-root   marker file (regular, root-owned)
#   /srv/lcp-offhost/incoming            0750 lcp-receive:lcp-audit
#   /srv/lcp-offhost/published           0750 lcp-vault:lcp-audit
#   /srv/lcp-offhost/quarantine          0700 lcp-vault
OFFHOST_ROOT=/srv/lcp-offhost
OFFHOST_PUBLISH_CMD=sudo -n /opt/lcp-offhost/bin/offhost-publish.sh
OFFHOST_VAULT_USER=lcp-vault
OFFHOST_AUDIT_GROUP=lcp-audit
OFFHOST_RECEIVE_USER=lcp-receive
# accepted slots for an upload: current slot and this many previous slots
OFFHOST_SLOT_WINDOW=2
#
# ── storage exhaustion limits (B23 G-6D C2) — a compromised upload key must
#    never fill the backup VPS. All three are validated; zero or unbounded
#    values are refused. Adjust consciously at activation and record why.
# Largest accepted encrypted archive. The daily plain-SQL gzip dump of the dev
# database is well below 100 MiB; 2 GiB leaves more than 20x growth headroom.
# (allowed range 1 MiB .. 64 GiB)
OFFHOST_MAX_ARCHIVE_BYTES=2147483648
# Archives accepted per 03:15 slot (an archive counts even without manifest;
# re-uploading an existing name answers EXISTS and never counts twice).
# (allowed range 1 .. 99)
OFFHOST_MAX_GENERATIONS_PER_SLOT=2
# Free space that uploads may never consume (checked before a byte is read and
# again immediately before publication). (allowed range 100 MiB .. 10 TB)
OFFHOST_MIN_FREE_BYTES=5368709120
OFFHOST_MAX_MANIFEST_BYTES=65536
# incoming files older than this are reported as stale by the auditor
OFFHOST_STALE_SECONDS=21600
# retention (vault identity, dry-run unless --apply) — housekeeping only, not
# the disk-exhaustion control
OFFHOST_RETAIN_DAYS=35
OFFHOST_PROTECT_NEWEST=7
OFFHOST_QUARANTINE_AFTER_DAYS=2
