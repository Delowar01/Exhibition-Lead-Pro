# =============================================================================
# Lead Capture Pro — primary VPS sender settings (EXAMPLE, B23 G-6D C1/C2)
# =============================================================================
# /opt/lead-capture-pro/env/offhost-send.env   (owner leadpro, mode 0600)
# Read by docker/scripts/offhost/offhost-send.sh (OFFHOST_SEND_CONFIG). Holds
# NO private key and NO credential: the SSH private keys stay in ~/.ssh, the
# age private key is NOT on this machine at all (owner custody, offline).
BACKUP_DIR=/opt/lead-capture-pro/backups/postgres
# receipts, lock and staging — never inside BACKUP_DIR
OFFHOST_STATE_DIR=/opt/lead-capture-pro/backups/offhost-state
OFFHOST_SSH_CONFIG=/opt/lead-capture-pro/env/offhost-ssh.config
# Host aliases of that ssh_config: the upload alias uses the upload key, the
# audit alias uses the PRIMARY audit key (GitHub Actions holds its own, third
# audit key). The sender binds every AUDIT listing to the upload HELLO
# identity (machine hash, file-system id, host keys) and fails closed before
# encryption when the two aliases do not reach the same machine.
OFFHOST_UPLOAD_TARGET=lcp-vault-upload
OFFHOST_AUDIT_TARGET=lcp-vault-audit
# age PUBLIC recipient (age1…); the matching identity never exists on any VPS
OFFHOST_RECIPIENT=age1<RECIPIENT-PLACEHOLDER-58-CHARACTERS>
# optional pins of the backup VPS identity as answered by HELLO and AUDIT
#   sha256 of the backup VPS /etc/machine-id (compare with the audit header)
OFFHOST_EXPECTED_MACHINE=
#   comma-separated SHA256: host-key fingerprints of the backup VPS
OFFHOST_EXPECTED_HOSTKEYS=
OFFHOST_ENV_LABEL=hosted-dev
OFFHOST_CONNECT_TIMEOUT=20
# single overall budget (seconds) for one run: encryption, HELLO, both AUDITs
# and both PUTs share it; exhausted → OFFHOST_UPLOAD=FAIL reason=operation-timeout
OFFHOST_MAX_TIME=1800
# tolerated difference between this clock and the backup VPS audit clock
OFFHOST_MAX_CLOCK_SKEW_SECONDS=900
OFFHOST_RECEIPT_KEEP_DAYS=60

# Documented crontab line for the deploy user (NOT activated by this branch;
# 35 min after the 03:15 backup and 5 min after the 03:45 local check):
#   50 3 * * * OFFHOST_SEND_CONFIG=/opt/lead-capture-pro/env/offhost-send.env bash /opt/lead-capture-pro/app/docker/scripts/offhost/offhost-send.sh >> /opt/lead-capture-pro/backups/offhost-state/send.log 2>&1
