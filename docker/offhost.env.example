# Lead Capture Pro — off-host backup copy configuration (B23 G-6D, Correction 1)
# Real file: /opt/lead-capture-pro/env/offhost.env  (owner leadpro, chmod 600)
# Read by docker/scripts/backup-offhost.sh via OFFHOST_CONFIG. Plain KEY=value
# lines only. This file holds NO credential and NO token path:
#   - the GitHub workflow backup-offhost.yml invokes the uploader over SSH and
#     provides the short-lived subject token per run in the environment
#     (OFFHOST_SUBJECT_TOKEN_FILE → a temporary /dev/shm file it deletes afterwards);
#     OFFHOST_SUBJECT_TOKEN_FILE / _URL are not accepted from this file;
#   - there is no service-account key and no local off-host cron;
#   - every endpoint is https:// (the uploader refuses http:// outside the test harness).

# Dedicated bucket used exclusively for these backups (Standard class, region me-central2 —
# pending CNTXT/KSA access confirmation; verify the live SKU before creation).
OFFHOST_BUCKET=<dedicated-backup-bucket-name>
OFFHOST_PREFIX=dev/postgres
OFFHOST_ENV_LABEL=hosted-dev
OFFHOST_REGION=me-central2

# Workload Identity Federation: audience of the GitHub OIDC provider used by the upload job.
OFFHOST_WIF_AUDIENCE=//iam.googleapis.com/projects/<project-number>/locations/global/workloadIdentityPools/<pool-id>/providers/<provider-id>
# Optional fallback only if direct principalSet bindings are refused at the provider test:
#OFFHOST_IMPERSONATE_SA=lcp-backup-uploader@<project-id>.iam.gserviceaccount.com

# Slots: current slot plus this many previous slots are considered (accepted: 7).
OFFHOST_BACKFILL_SLOTS=7
# Local operational state (receipts, lock, log) — never the backup directory.
OFFHOST_RECEIPT_DIR=/opt/lead-capture-pro/backups/offhost-receipts
BACKUP_DIR=/opt/lead-capture-pro/backups/postgres
OFFHOST_RECEIPT_KEEP_DAYS=60
# GitHub-derived credentials are treated as five-minute credentials (0..300).
OFFHOST_CREDENTIAL_WINDOW_SECONDS=300

# Provider endpoints (HTTPS only; defaults shown).
#OFFHOST_STORAGE_ENDPOINT=https://storage.googleapis.com
#OFFHOST_STS_ENDPOINT=https://sts.googleapis.com/v1/token
#OFFHOST_IAMCREDENTIALS_ENDPOINT=https://iamcredentials.googleapis.com
#OFFHOST_SCOPE=https://www.googleapis.com/auth/devstorage.read_write
#OFFHOST_RETRY_MAX=3
#OFFHOST_RETRY_BASE_SECONDS=2
#OFFHOST_CONNECT_TIMEOUT=20
#OFFHOST_MAX_TIME=120
